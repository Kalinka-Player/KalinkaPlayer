[Unit]
Description=Kalinka Supervisor
After=dietpi-preboot.service dietpi-firstboot.service kalinka-firstboot.service bluetooth.service NetworkManager.service
Wants=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/kalinka-supervisor
# The root mount is intentionally read-only; writes use the paths below.
Environment=G_CHECK_ROOTFS_RW_VERIFIED=1
Environment=G_INTERACTIVE=0
ExecStart=/usr/lib/kalinka-supervisor/kalinka-supervisor --backend auto
Restart=on-failure
RestartSec=10
WatchdogSec=60
TimeoutStopSec=130
RuntimeDirectory=kalinka-supervisor
RuntimeDirectoryMode=0700
StateDirectory=kalinka-supervisor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
# No ProtectKernelTunables=: authorized radio recovery writes /sys/class/rfkill.
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# DietPi's own networking tool updates these files; NM writes via its daemon.
ReadWritePaths=/var/lib/kalinka-supervisor /run
ReadWritePaths=-/etc/network -/etc/wpa_supplicant -/etc/resolv.conf -/etc/dhcp
# The nm backend keeps the joined network's Wi-Fi country in kalinka-regdom.conf.
ReadWritePaths=-/etc/modprobe.d
ReadWritePaths=-/boot -/var/lib/dietpi -/var/lib/dhcp -/var/lib/kalinka-image

[Install]
WantedBy=multi-user.target
