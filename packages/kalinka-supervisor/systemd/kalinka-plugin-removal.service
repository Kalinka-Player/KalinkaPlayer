[Unit]
Description=Remove a Kalinka plugin package on request

[Service]
Type=oneshot
# apt waits for the package lock and the plugin's prerm uninstalls from Core's environment: no safe bound, as for the reinstall.
TimeoutStartSec=infinity
StateDirectory=kalinka-supervisor
StateDirectoryMode=0700
LogsDirectory=kalinka-supervisor
StandardOutput=truncate:/var/log/kalinka-supervisor/plugin-removal.log
StandardError=inherit
ExecStart=/usr/lib/kalinka-supervisor/remove-plugin.sh /var/lib/kalinka-supervisor/plugin-removal-request
# The unit's own result is gone once systemd unloads it; the supervisor reads this instead.
ExecStopPost=/bin/sh -c 'echo "$SERVICE_RESULT" > /var/lib/kalinka-supervisor/plugin-removal-result'
