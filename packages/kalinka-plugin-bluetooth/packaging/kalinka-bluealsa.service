[Unit]
Description=Kalinka Bluetooth A2DP receiver
Requires=bluetooth.service
After=bluetooth.service
Conflicts=bluealsa.service

[Service]
# No BusName: systemd refuses two units watching one bus name, and bluealsa.service already claims org.bluealsa.
Type=exec
ExecStart=/usr/lib/kalinka-plugin-bluetooth/start-bluealsa
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
