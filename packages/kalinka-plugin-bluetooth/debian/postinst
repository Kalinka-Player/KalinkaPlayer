#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if command -v systemd-tmpfiles >/dev/null; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/kalinka-bluetooth.conf
    fi
    # Only kalinka.service may start the receiver; bluealsa-aplay would bypass Kalinka entirely.
    systemctl disable bluealsa.service bluealsa-aplay.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl stop bluealsa-aplay.service || true
        if systemctl is-active --quiet kalinka.service; then
            systemctl restart bluealsa.service || true
        else
            systemctl stop bluealsa.service || true
        fi
        systemctl reload dbus.service || true
    fi
fi
