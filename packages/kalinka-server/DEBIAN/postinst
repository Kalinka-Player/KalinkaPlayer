#!/usr/bin/env bash
set -euo pipefail

# --- Configurable paths/users ---
USER="kalusr"
INSTALL_DIR="/opt/kalinka"
CONFIG_DIR="/etc/kalinka"
STATE_DIR="/var/lib/kalinka"
SERVER_ID="${STATE_DIR}/server_id"
UNIT_DIR="/etc/systemd/system"
UNIT_NAME="kalinka.service"
UNIT_PATH="${UNIT_DIR}/${UNIT_NAME}"
RESTART_PATH_UNIT="kalinka-restart.path"
PLUGINS_PATH_UNIT="kalinka-plugins.path"
# While the plugin helper works beside a running Core, a plugin package's
# trigger must leave Core alone.
LIVE_OPERATION_MARKER="/run/kalinka/plugin-live-operation"
UPGRADE_PATH_UNIT="kalinka-upgrade.path"
JOURNAL_READER_SOCKET="kalinka-journal-reader.socket"
MOUNTS_PATH_UNIT="kalinka-mounts.path"

case "$1" in
  configure)
    echo "[1/5] Ensure system user exists (nologin)"
    if ! id -u "$USER" >/dev/null 2>&1; then
      adduser --system --no-create-home --group --disabled-login "$USER"
    else
      usermod -s /usr/sbin/nologin "$USER" || true
    fi

    # No audio group: the server stopped opening sound devices when playback
    # moved to the renderer, and the renderer now runs as its own user. Drop
    # the membership older versions granted — unless a renderer old enough to
    # still run as kalusr is installed here, which would lose its sound card
    # the moment we did. Its own upgrade moves it off kalusr, and the next
    # server upgrade finishes this.
    RENDERER_UNIT=/usr/lib/systemd/system/kalinka-renderer.service
    if id -nG "$USER" 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
      if [ -f "$RENDERER_UNIT" ] && grep -q '^User=kalusr' "$RENDERER_UNIT"; then
        echo "      leaving $USER in 'audio': kalinka-renderer still runs as $USER"
      else
        gpasswd -d "$USER" audio >/dev/null 2>&1 || true
      fi
    fi

    echo "[2/5] Create install/config directories"
    install -d -m 0755 "$INSTALL_DIR"
    install -d -m 0750 -o "$USER" -g "$USER" "$CONFIG_DIR"
    # Default music drop-off folder (matches the localfiles plugin's
    # music_folders default). World-writable on purpose: any local user
    # (or SFTP login) can drop music in without sudo — this is a
    # single-admin appliance, not a multi-tenant box. Sticky bit so
    # uploaders can only delete their own files; setgid so new files
    # land in the kalusr group (note: their mode still follows the
    # uploader's umask, so the service can't *read* a 0600 drop).
    # Never touched if it already exists — it's admin territory.
    [ -d /srv/kalinka ] || install -d -m 0755 /srv/kalinka
    if [ ! -d /srv/kalinka/music ]; then
      install -d -m 3777 -o root -g "$USER" /srv/kalinka/music
    fi

    echo "[3/5] Lock down config permissions"
    chown -R "$USER:$USER" "$CONFIG_DIR"
    # Files 0600, directories 0700
    find "$CONFIG_DIR" -type f -exec chmod 600 {} \;
    find "$CONFIG_DIR" -type d -exec chmod 700 {} \;

    # Here rather than at Core's first start, so the supervisor can report it before Core has run.
    echo "[4/5] Create the server id if there is none"
    # A file Core would take for malformed and replace is none either.
    if ! python3 -c 'import sys, uuid; uuid.UUID(open(sys.argv[1]).read().strip())' "$SERVER_ID" 2>/dev/null; then
      [ -d "$STATE_DIR" ] || install -d -m 0750 -o "$USER" -g "$USER" "$STATE_DIR"
      python3 -c 'import uuid; print(uuid.uuid4())' > "$SERVER_ID.new"
      chown "$USER:$USER" "$SERVER_ID.new"
      # Core and the app key on it from now on, so it has to outlast a power cut.
      sync "$SERVER_ID.new"
      mv "$SERVER_ID.new" "$SERVER_ID"
      sync "$STATE_DIR"
    fi

    echo "[5/5] systemd: enable the units, and start them if systemd is running"
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/kalinka.conf || true
    # A container or chroot runs no systemd, and may have no systemctl. Enabling
    # needs only the unit files, and is how an image build gets the units it
    # boots with; starting is left to a running systemd.
    have_systemctl=""
    if command -v systemctl >/dev/null 2>&1; then
      have_systemctl=1
    else
      echo "Note: no systemctl here. Skipping enable/start."
    fi
    if [ -n "$have_systemctl" ] && [ -d /run/systemd/system ]; then
      systemctl daemon-reload
    fi
    for unit in "$RESTART_PATH_UNIT" "$PLUGINS_PATH_UNIT" "$UPGRADE_PATH_UNIT" \
                "$JOURNAL_READER_SOCKET" "$MOUNTS_PATH_UNIT"; do
      if [ ! -f "$UNIT_DIR/$unit" ]; then
        echo "Note: $unit not found at $UNIT_DIR/$unit. Skipping."
      elif [ -n "$have_systemctl" ]; then
        systemctl enable "$unit"
        if [ -d /run/systemd/system ]; then
          systemctl start "$unit"
        fi
      fi
    done
    # Drives plugged in before this install are mounted now, not at the next plug.
    if command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules || true
      # Drives already plugged in, and only those on USB.
      for dev in /sys/class/block/*; do
        case "$(readlink -f "$dev")" in
          */usb*) udevadm trigger --action=add "$dev" || true ;;
        esac
      done
    fi
    if [ ! -f "$UNIT_PATH" ]; then
      echo "Note: $UNIT_NAME not found at $UNIT_PATH. Skipping enable/start."
    elif [ -n "$have_systemctl" ]; then
      systemctl enable "$UNIT_NAME"
      if [ -d /run/systemd/system ]; then
        systemctl restart "$UNIT_NAME"
        systemctl --no-pager --full status "$UNIT_NAME" || true
      else
        echo "Note: systemd is not running here. $UNIT_NAME is enabled, not started."
      fi
    fi

    echo "Installation complete."
    ;;

  triggered)
    # A Core stopped for a package operation is started once, afterwards, by whoever stopped it.
    if [ -e "$LIVE_OPERATION_MARKER" ]; then
      echo "[triggered] $UNIT_NAME is taking the plugin in itself; not restarting it."
    elif [ -d /run/systemd/system ]; then
      echo "[triggered] Restarting $UNIT_NAME if it is running..."
      systemctl try-restart "$UNIT_NAME" || true
    fi
    ;;
esac
