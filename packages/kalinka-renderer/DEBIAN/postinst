#!/usr/bin/env bash
set -euo pipefail

# The renderer has its own account rather than sharing the server's kalusr:
# it is the network-facing half, and it has no business reading the server's
# config (API keys, 0600 kalusr) or touching the upgrade trigger kalusr may
# write. All it needs is the sound devices and its own state directory.
USER="kalrndr"
STATE_DIR="/var/lib/kalinka-renderer"
UNIT_NAME="kalinka-renderer.service"
UPGRADE_PATH_UNIT="kalinka-renderer-upgrade.path"

# As dh_installsystemd does: needs no running systemd, and keeps an owner's disable across upgrades.
enable_unit() {
  if deb-systemd-helper --quiet was-enabled "$1"; then
    deb-systemd-helper enable "$1"
  else
    deb-systemd-helper update-state "$1"
  fi
}

case "$1" in
  configure)
    if ! id -u "$USER" >/dev/null 2>&1; then
      adduser --system --no-create-home --group --disabled-login "$USER"
    fi
    usermod -aG audio "$USER" || true

    # Releases up to 0.1.0 ran as kalusr, so an upgraded box has a state
    # directory the new user cannot write. The renderer id lives in there and
    # is how a server tells one renderer from another — losing it would strand
    # the output selection against an id that never comes back.
    if [ -d "$STATE_DIR" ]; then
      chown -R "$USER:$USER" "$STATE_DIR"
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
    fi
    # Enabled with or without a running systemd: that is how an image build gets the renderer it boots with.
    enable_unit "$UNIT_NAME"
    # Enabling arms the watcher at boot; starting arms it for this one, so an
    # upgrade requested before the next reboot is still acted on.
    enable_unit "$UPGRADE_PATH_UNIT"
    if [ -d /run/systemd/system ]; then
      deb-systemd-invoke start "$UPGRADE_PATH_UNIT"
      deb-systemd-invoke restart "$UNIT_NAME"
    else
      echo "Note: systemd is not running here, so nothing was started."
    fi
    ;;
esac

exit 0
